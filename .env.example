# LLM Configuration (OpenAI-compatible API)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0

# LLM Model Downgrade — simple tasks (SQL fix, chart, explanation) use this cheaper model
LLM_MODEL_SMALL=gpt-4o-mini
LLM_AUTO_DOWNGRADE=true

# Database
DATABASE_URL=sqlite+aiosqlite:///data/demo.db

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Auth (empty key = disabled)
AUTH_ENABLED=false
AUTH_API_KEY=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=128

# Context Management
CONTEXT_MAX_TOKENS=8000
CONTEXT_SUMMARY_THRESHOLD=12

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
